# Platform : comptes organisateurs + profil club + tournois persistants.
# Live Manager local (même code que Engine V2, sessions sur Platform).
# Regénération PDF team-change via Engine V2 distant (ENGINE_V2_URL).
FROM node:20-slim AS frontend-build

ARG FRONTEND_BUILD_ID=platform-20260727
RUN echo "Frontend build id: ${FRONTEND_BUILD_ID}"

WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ .
RUN echo "${FRONTEND_BUILD_ID}" > .docker-build-id
ENV VITE_DEPLOY_TARGET=platform
ENV VITE_ENGINE_V2_URL=https://tournament-manager-engine-v2.onrender.com
RUN npm run build && test -f dist/index.html

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DEPLOY_TARGET=platform \
    LIVE_DATA_DIR=/tmp/_live \
    HOME=/tmp \
    MALLOC_ARENA_MAX=2

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        fonts-dejavu \
        fonts-liberation \
        fonts-noto \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-platform.txt .
RUN pip install --no-cache-dir -r requirements-platform.txt

COPY api/ ./api/
COPY engine/ ./engine/
COPY engine_v2/ ./engine_v2/
COPY fonts/ ./fonts/
COPY schema/ ./schema/
COPY --from=frontend-build /app/frontend/dist ./frontend/dist

RUN mkdir -p /tmp/_live && chmod 777 /tmp/_live
RUN test -f frontend/dist/index.html
RUN python3 -c "from api.main_platform import app"

EXPOSE 8000

CMD ["sh", "-c", "uvicorn api.main_platform:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --timeout-keep-alive 300"]
