# Platform : comptes organisateurs + profil club + tournois persistants.
# Pas de moteur PDF / Live — appelle Engine V2 via ENGINE_V2_URL.
FROM node:20-slim AS frontend-build

ARG FRONTEND_BUILD_ID=platform-20260726
RUN echo "Frontend build id: ${FRONTEND_BUILD_ID}"

WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ .
RUN echo "${FRONTEND_BUILD_ID}" > .docker-build-id
ENV VITE_DEPLOY_TARGET=platform
ENV VITE_ENGINE_V2_URL=https://tournament-manager-engine-v2.onrender.com
RUN npm run build && test -f dist/index.html

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DEPLOY_TARGET=platform \
    HOME=/tmp \
    PLATFORM_DATA_DIR=/data/platform

WORKDIR /app

COPY requirements-platform.txt .
RUN pip install --no-cache-dir -r requirements-platform.txt

COPY api/ ./api/
COPY schema/ ./schema/
COPY --from=frontend-build /app/frontend/dist ./frontend/dist

RUN test -f frontend/dist/index.html
RUN python3 -c "from api.main_platform import app"

RUN mkdir -p /data/platform \
    && chmod -R 777 /data/platform /tmp

EXPOSE 8000

CMD ["sh", "-c", "uvicorn api.main_platform:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1"]
