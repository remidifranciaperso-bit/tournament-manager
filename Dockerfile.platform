# Platform : comptes organisateurs + profil club + tournois persistants.
# Regénération PDF team-change en local (snapshot + captures) — pas d'appel HTTP Engine V2.
FROM node:20-slim AS frontend-build

ARG FRONTEND_BUILD_ID=platform-20260726
RUN echo "Frontend build id: ${FRONTEND_BUILD_ID}"

WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ .
RUN echo "${FRONTEND_BUILD_ID}" > .docker-build-id
ENV VITE_DEPLOY_TARGET=platform
ENV VITE_ENGINE_V2_URL=https://tournament-manager-engine-v2.onrender.com
RUN npm run build && test -f dist/index.html

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DEPLOY_TARGET=platform \
    HOME=/tmp \
    MALLOC_ARENA_MAX=2

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        fonts-dejavu \
        fonts-liberation \
        fonts-noto \
        fonts-noto-color-emoji \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY fonts/ /usr/share/fonts/truetype/tournament/
RUN fc-cache -f -v > /dev/null

WORKDIR /app

COPY requirements-platform.txt requirements-docker.txt ./
RUN pip install --no-cache-dir -r requirements-platform.txt -r requirements-docker.txt

COPY api/ ./api/
COPY schema/ ./schema/
COPY engine/ ./engine/
COPY engine_v2/ ./engine_v2/
COPY fonts/ ./fonts/
COPY "templates bleus/" "./templates bleus/"
COPY scripts/bake_emoji_assets.py ./scripts/

RUN cp /usr/share/fonts/truetype/noto/NotoColorEmoji.ttf /app/fonts/NotoColorEmoji.ttf \
    && test -f /app/fonts/NotoColorEmoji.ttf \
    && python3 scripts/bake_emoji_assets.py \
    && fc-cache -f -v > /dev/null

COPY --from=frontend-build /app/frontend/dist ./frontend/dist

RUN test -f frontend/dist/index.html
RUN python3 -c "from api.main_platform import app"
RUN python3 -c "from engine_v2.snapshot_regen import regenerate_pdf_from_snapshot"

EXPOSE 8000

CMD ["sh", "-c", "uvicorn api.main_platform:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --timeout-keep-alive 120"]
